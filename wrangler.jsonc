/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "daily-news-digest",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyMCP",
				"name": "MCP_OBJECT"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	// =============================================
	// Enterprise: CPU時間上限を引き上げ
	// https://developers.cloudflare.com/workers/platform/limits/#increasing-the-cpu-time-limit
	// =============================================
	"limits": {
		"cpu_ms": 30000
	},
	// =============================================
	// Cron Trigger: 毎朝 UTC 00:00 (JST 09:00) に実行
	// =============================================
	"triggers": {
		"crons": ["0 22 * * *"]
	},
	// =============================================
	// シークレット値は `wrangler secret put` で設定してください:
	//   wrangler secret put ANTHROPIC_API_KEY   # Anthropic APIキー
	//   wrangler secret put RESEND_API_KEY      # Resend APIキー
	//   wrangler secret put SENDER_EMAIL        # 送信元メールアドレス
	//   wrangler secret put RECIPIENT_EMAIL     # 受信メールアドレス
	//   wrangler secret put RECIPIENT_NAME      # 受信者名（任意）
	// =============================================
}
